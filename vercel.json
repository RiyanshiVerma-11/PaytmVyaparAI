{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "frontend",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://paytmvyaparai.onrender.com/api/$1"
    },
    {
      "source": "/static/(.*)",
      "destination": "/$1"
    }
  ]
}
